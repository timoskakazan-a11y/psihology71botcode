# Copy this file to .env.local for local development, and set the same
# values in Netlify: Site configuration → Environment variables.
# NEVER commit real values to git.

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional but recommended: a random secret string. When set, it's sent to
# Telegram on setWebhook and required on every incoming update, so no one
# else can POST fake updates to your webhook URL.
TELEGRAM_WEBHOOK_SECRET=

# Supabase project used to persist the group binding, tickets and messages.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
